#!/bin/sh
# Mirrors .agents/<vendor>/ into the vendor's own config folder (.claude, .codex, .cursor).
# Shared .agents/skills/ is copied into every vendor that has a folder here.
set -e
cd "$(dirname "$0")/.."

for vendor in claude codex cursor; do
  [ -d ".agents/$vendor" ] || continue
  mkdir -p ".$vendor"
  cp -R ".agents/$vendor/." ".$vendor/"
  if [ -d .agents/skills ]; then
    mkdir -p ".$vendor/skills"
    cp -R .agents/skills/. ".$vendor/skills/"
  fi
done

# Vendor-agnostic guard: warn about a skill dropped straight into a vendor folder
# (e.g. a plugin installer writing to .claude/skills) instead of the shared source.
# The mirror above only copies .agents/skills/*, so anything extra was added the wrong way.
for vendor in claude codex cursor; do
  [ -d ".$vendor/skills" ] || continue
  for dir in ".$vendor/skills"/*/; do
    [ -d "$dir" ] || continue
    name=$(basename "$dir")
    [ -d ".agents/skills/$name" ] && continue
    echo "warning: .$vendor/skills/$name is not in .agents/skills/ — move it there so every vendor gets it (vendor-agnostic rule)." >&2
  done
done

# ponytail: copy-over, never delete — .claude also holds untracked settings.local.json.
# Add pruning of stale mirrored files only if renames in .agents actually start biting.
